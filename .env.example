# Скопируйте в .env при необходимости изменить настройки.
# Без .env проект запускается со значениями по умолчанию.

POSTGRES_DB=kinopolka
POSTGRES_USER=kino
POSTGRES_PASSWORD=kino123

# Ключ OMDb API (бесплатно: https://www.omdbapi.com/apikey.aspx).
# Пусто: web-service работает как локальный эмулятор OMDb.
OMDB_API_KEY=

FRONTEND_PORT=8080
